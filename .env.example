# Used by docker-compose for the Postgres container and the services' DATABASE_URL.
# An existing volume keeps the password it was created with.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://quantflow_admin:<POSTGRES_PASSWORD>@localhost:6000/quantflow_db
ENV=development
ENCRYPTION_KEY=
JWT_SECRET_KEY=
# Plain-http local development only; keep true anywhere else.
COOKIE_SECURE=false
# paper (default, no orders sent) | testnet | live (also needs LIVE_TRADING_ENABLED=true)
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
# Only these symbols can be sized and ordered (all modes); Bybit tags are not trusted alone
TRADABLE_SYMBOLS=BTC/USDT,ETH/USDT
# Risk limits (entries only; exits are never blocked)
TRADING_HALTED=false
MAX_DAILY_LOSS_PCT=3
MAX_DRAWDOWN_PCT=10
MAX_USER_EXPOSURE_USDT=1000
MAX_STOP_LOSS_PCT=10
# Log SQL statements (parameters are always hidden)
SQL_ECHO=false
# Worker logging: json (default) | text
LOG_FORMAT=json
# Operational alerts (always logged; webhook optional)
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_SECONDS=900
WORKER_STALE_SECONDS=60
AUDIT_EVERY_CYCLES=30
# Machine learning (see README). Artifacts are JSON, loaded once at worker start.
ML_MODEL_PATH=
ML_SHADOW_ENABLED=true
# Lets ML_SIGNAL bots trade on an APPROVED artifact in paper/testnet. Never in live.
ML_TRADING_ENABLED=false
