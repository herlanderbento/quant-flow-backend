# Copie este ficheiro para .env e ajuste os valores:
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows CMD)

# Ambiente de execução (development | production)
ENV=development

# Base de dados PostgreSQL (driver async)
# Com Docker Compose: Postgres exposto em localhost:6000
# O backend converte automaticamente postgresql:// para postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://quantflow_admin:quantflow_password_2026@localhost:6000/quantflow_db

# Chave simétrica Fernet para encriptar credenciais de exchanges (ex.: Binance)
# Gerar uma chave nova:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# JWT e cookies de autenticação
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax